{
  "name": "armory-os",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "ARMORY OS: interactive digital firearms exhibition",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:update": "playwright test --update-snapshots",
    "validate": "node --experimental-strip-types --no-warnings scripts/validate.ts"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.0"
  }
}
